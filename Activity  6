#include <iostream>

class Complex {
private:
    double real;
    double imag;

public:
    // Constructor with default values
    Complex(double r = 0.0, double i = 0.0) : real(r), imag(i) {}

    // Overload binary - operator using a member function
    Complex operator-(const Complex& other) const {
        return Complex(real - other.real, imag - other.imag);
    }

    // Utility function to display the complex number
    void display() const {
        if (imag >= 0)
            std::cout << real << " + " << imag << "i" << std::endl;
        else
            std::cout << real << " - " << -imag << "i" << std::endl;
    }
};

int main() {
    Complex c1(8.5, 5.2);
    Complex c2(3.2, 7.4);

    // Subtracting c2 from c1 using the overloaded - operator
    Complex result = c1 - c2;

    std::cout << "c1 = ";
    c1.display();

    std::cout << "c2 = ";
    c2.display();

    std::cout << "c1 - c2 = ";
    result.display();

    return 0;
}
