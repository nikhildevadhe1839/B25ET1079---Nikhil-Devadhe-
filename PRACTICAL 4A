#include <iostream>
using namespace std;

class complex{
    private:
    float real;
    float imag;

    public:

    void getData(){
        cout << "Enter real part: ";
        cin >> real;

        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void display(){
        if (imag >= 0)
            cout << real << " + " << imag << "i";
        else
            cout << real << " - " << -imag << "i";
    }
};

int main(){
    complex c;
    cout << "Enter complex number:\n";
    c.getData();
    cout << "The complex number is : ";
    c.display();

}
